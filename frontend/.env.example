# ClaimShield AI Frontend Environment Variables

# The base URL of your deployed ClaimShield FastAPI backend (without trailing /api)
# Example: https://claimshield-backend.onrender.com
# Leave empty for local development (defaults to local Vite proxy at /api)
VITE_API_URL=

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
